<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doar | DiscoverBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,500&family=Karla:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/doar.css">
    <link rel="stylesheet" href="/css/doar-impacto.css">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css">
</head>
<body class="doar-page">

<%- include('partials/topo') %>
<%- include('partials/header') %>
<%- include('partials/nav-categorias') %>

<!-- ================= HERO ================= -->
<section class="di-hero">
    <span class="di-bolha di-b1" aria-hidden="true"></span>
    <span class="di-bolha di-b2" aria-hidden="true"></span>
    <span class="di-bolha di-b3" aria-hidden="true"></span>

    <div class="di-hero-inner">
        <div class="di-hero-texto">
            <h1>Doe um livro.<br>Mude uma sala de aula.</h1>
            <p class="di-sub">Leva menos de 3 minutos.</p>

            <a href="#form-doacao" class="di-cta">
                <i class="fi fi-rr-book-alt" aria-hidden="true"></i>
                Quero doar meu livro
            </a>

            <div class="di-contador" aria-label="Livros no acervo">
                <i class="fi fi-rr-heart" aria-hidden="true"></i>
                <span><strong><%= statsAcervo.exemplares %></strong> livros já esperam por uma escola</span>
            </div>
        </div>

        <div class="di-pilha" aria-hidden="true">
            <img class="di-capa di-capa-1" src="/img/matilda.jpg" alt="">
            <img class="di-capa di-capa-2" src="/img/malala.webp" alt="">
            <img class="di-capa di-capa-3" src="/img/chapeuzinho.webp" alt="">
            <span class="di-selo"><i class="fi fi-rr-graduation-cap"></i></span>
        </div>
    </div>

    <svg class="di-onda" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,40 C240,90 480,0 720,30 C960,60 1200,90 1440,35 L1440,80 L0,80 Z" fill="#efeaff"/>
    </svg>
</section>

<!-- ================= 3 PASSOS ================= -->
<ol class="di-passos" aria-label="Como funciona">
    <li><span class="di-passo-ico di-p1"><i class="fi fi-rr-book-alt"></i></span><b>Conte do livro</b></li>
    <li class="di-seta" aria-hidden="true"><i class="fi fi-rr-angle-small-right"></i></li>
    <li><span class="di-passo-ico di-p2"><i class="fi fi-rr-camera"></i></span><b>Mande a foto</b></li>
    <li class="di-seta" aria-hidden="true"><i class="fi fi-rr-angle-small-right"></i></li>
    <li><span class="di-passo-ico di-p3"><i class="fi fi-rr-graduation-cap"></i></span><b>Ele vai pra uma escola</b></li>
</ol>

<!-- ================= FORMULÁRIO ================= -->
<section class="doar-form-section" id="form-doacao">

    <div class="doar-cabecalho">
        <h2>Ficha do livro</h2>
        <p>Campos com * são obrigatórios.</p>
    </div>

    <% if (erro === "foto") { %>
        <p class="doar-mensagem doar-mensagem-erro">
            Não foi possível enviar a foto (verifique se ela foi selecionada e se é uma imagem de até 5MB). Tente novamente.
        </p>
    <% } else if (erro === "escola") { %>
        <p class="doar-mensagem doar-mensagem-erro">
            Escolha a escola que vai receber o livro.
        </p>
    <% } else if (erro) { %>
        <p class="doar-mensagem doar-mensagem-erro">
            Erro ao registrar doação. Tente novamente.
        </p>
    <% } %>

    <div class="doar-form-wrap">
        <form class="doar-cartao-form" action="/doar" method="POST" enctype="multipart/form-data">

            <fieldset>
                <legend><span class="doar-bolha">1</span> Sobre o livro</legend>

                <label for="livro">Título do livro *</label>
                <input type="text" id="livro" name="livro" placeholder="Ex: Sítio do Picapau Amarelo" required>

                <label for="quantidade">Quantidade *</label>
                <input class="doar-input-curto" type="number" id="quantidade" name="quantidade" min="1" value="1" required>

                <label for="descricao">Estado do livro *</label>
                <textarea id="descricao" name="descricao" class="doar-textarea" rows="4" placeholder="Como está o livro? (novo, seminovo, com marcas de uso…)" required></textarea>
            </fieldset>

            <fieldset>
                <legend><span class="doar-bolha">2</span> Categoria</legend>

                <div class="doar-faixas">

                    <label class="doar-faixa-card">
                        <input type="radio" name="categoria" value="infantil" required>
                        <span class="doar-faixa-icone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        </span>
                        <span class="doar-faixa-texto">
                            <h4>Infantil</h4>
                        </span>
                        <span class="doar-check"></span>
                    </label>

                    <label class="doar-faixa-card">
                        <input type="radio" name="categoria" value="fundamental" required>
                        <span class="doar-faixa-icone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 6.5C10.3 5 7.8 4 5 4v13c2.8 0 5.3 1 7 2.5C13.7 18 16.2 17 19 17V4c-2.8 0-5.3 1-7 2.5z"/></svg>
                        </span>
                        <span class="doar-faixa-texto">
                            <h4>Ensino Fundamental</h4>
                        </span>
                        <span class="doar-check"></span>
                    </label>

                    <label class="doar-faixa-card">
                        <input type="radio" name="categoria" value="medio" required>
                        <span class="doar-faixa-icone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m22 10-10-5L2 10l10 5 10-5Z"/><path d="M6 12.5V17c0 1.1 2.7 2 6 2s6-.9 6-2v-4.5"/><path d="M22 10v6"/></svg>
                        </span>
                        <span class="doar-faixa-texto">
                            <h4>Ensino Médio</h4>
                        </span>
                        <span class="doar-check"></span>
                    </label>

                    <label class="doar-faixa-card">
                        <input type="radio" name="categoria" value="leituras" required>
                        <span class="doar-faixa-icone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        </span>
                        <span class="doar-faixa-texto">
                            <h4>Leituras</h4>
                        </span>
                        <span class="doar-check"></span>
                    </label>

                </div>
            </fieldset>

            <%- include('partials/doar-escola', { numero: 3, escolas, selecionada: null }) %>

            <fieldset>
                <legend><span class="doar-bolha">4</span> Seus dados</legend>

                <div class="doar-grid-2">
                    <div>
                        <label for="nome">Nome *</label>
                        <input type="text" id="nome" name="nome" placeholder="Seu nome" value="<%= doadorNome %>" required>
                    </div>
                    <div>
                        <label for="telefone">Telefone *</label>
                        <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" required>
                    </div>
                </div>

                <label for="email">Email *</label>
                <input type="email" id="email" name="email" placeholder="Seu email" value="<%= doadorEmail %>" required>
                <span class="doar-dica-campo">Só usamos para combinar a entrega.</span>
            </fieldset>

            <fieldset>
                <legend><span class="doar-bolha">5</span> Foto da capa</legend>

                <label class="doar-drop-foto" id="doarDropFoto">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M8 6l2-3h4l2 3"/><circle cx="12" cy="13" r="3.5"/></svg>
                    <span><b>Toque para escolher a foto</b> ou arraste aqui</span>
                    <input type="file" name="foto" id="foto" accept="image/png, image/jpeg, image/webp" required>
                    <span class="doar-nome-arquivo" id="doarNomeArquivo"></span>
                </label>
                <span class="doar-dica-campo">Foto da capa, até 5MB.</span>
            </fieldset>

            <div class="doar-botoes-form">
                <p class="di-motivo"><i class="fi fi-rr-sparkles" aria-hidden="true"></i> Seu livro vai ganhar uma nova história.</p>
                <button type="submit" class="doar-btn-primario di-enviar"><i class="fi fi-rr-book-alt" aria-hidden="true"></i> Enviar minha doação</button>
            </div>
        </form>
    </div>

    <details class="di-duvidas">
        <summary><i class="fi fi-rr-interrogation" aria-hidden="true"></i> E depois que eu enviar?</summary>
        <ul>
            <li><b>48h pra mudar de ideia:</b> edite ou cancele pelo seu <a href="/perfil?aba=doados">perfil</a>.</li>
            <li><b>Depois disso</b> o livro entra no <a href="/acervo">acervo</a>.</li>
            <li><b>Quando uma escola pedir,</b> a gente chama você pra combinar a entrega.</li>
        </ul>
    </details>

</section>

<%- include('partials/footer') %>

<a href="https://wa.me/5599999999999" class="whatsapp" target="_blank">
    <img src="/img/whatsapp.png" alt="WhatsApp">
</a>

<!-- ================= POP-UP DE SUCESSO DA DOAÇÃO ================= -->
<div class="doar-sucesso-overlay" id="doarSucessoOverlay" role="dialog" aria-modal="true" aria-labelledby="doarSucessoTitulo" hidden>
    <div class="doar-sucesso-cartao">
        <span class="doar-sucesso-confete">🎉</span>
        <span class="doar-sucesso-confete c2">📚</span>
        <span class="doar-sucesso-confete c3">💜</span>
        <span class="doar-sucesso-confete c4">✨</span>

        <div class="doar-sucesso-icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
        </div>

        <h3 id="doarSucessoTitulo">Livro doado com sucesso!</h3>
        <p>Muito obrigado por espalhar leitura 💜 Seu livro já está brilhando no acervo, prontinho para encontrar uma escola.</p>

        <button type="button" class="doar-sucesso-btn" id="doarSucessoFechar">Que alegria! ✨</button>
    </div>
</div>

<script>
    const doarSucessoOverlay = document.getElementById('doarSucessoOverlay');
    const doarSucessoFechar = document.getElementById('doarSucessoFechar');
    const doarSucesso = <%- sucesso ? 'true' : 'false' %>;

    function abrirDoarSucesso() {
        if (!doarSucessoOverlay) return;
        doarSucessoOverlay.hidden = false;
        document.body.style.overflow = 'hidden';
    }

    function fecharDoarSucesso() {
        if (!doarSucessoOverlay) return;
        doarSucessoOverlay.hidden = true;
        document.body.style.overflow = '';

        // Limpa o ?sucesso=1 da URL pra não reabrir o pop-up se a pessoa recarregar a página
        const url = new URL(window.location.href);
        url.searchParams.delete('sucesso');
        window.history.replaceState({}, '', url);
    }

    if (doarSucesso) {
        abrirDoarSucesso();
    }

    if (doarSucessoFechar) {
        doarSucessoFechar.addEventListener('click', fecharDoarSucesso);
    }

    if (doarSucessoOverlay) {
        doarSucessoOverlay.addEventListener('click', (e) => {
            if (e.target === doarSucessoOverlay) fecharDoarSucesso();
        });
    }
</script>

<script>
    const doarInputFoto = document.getElementById('foto');
    const doarNomeArquivo = document.getElementById('doarNomeArquivo');
    const doarDropFoto = document.getElementById('doarDropFoto');

    if (doarInputFoto && doarNomeArquivo) {
        doarInputFoto.addEventListener('change', () => {
            const arquivo = doarInputFoto.files && doarInputFoto.files[0];
            doarNomeArquivo.textContent = arquivo ? arquivo.name : '';
        });
    }

    if (doarDropFoto && doarInputFoto) {
        ['dragover', 'dragenter'].forEach((evento) => {
            doarDropFoto.addEventListener(evento, (e) => {
                e.preventDefault();
                doarDropFoto.classList.add('doar-drop-foto-ativo');
            });
        });
        ['dragleave', 'drop'].forEach((evento) => {
            doarDropFoto.addEventListener(evento, (e) => {
                e.preventDefault();
                doarDropFoto.classList.remove('doar-drop-foto-ativo');
            });
        });
        doarDropFoto.addEventListener('drop', (e) => {
            const arquivos = e.dataTransfer.files;
            if (arquivos && arquivos.length) {
                doarInputFoto.files = arquivos;
                doarNomeArquivo.textContent = arquivos[0].name;
            }
        });
    }
</script>

</body>
</html>
