<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leituras - DiscoverBook</title>

    <link rel="stylesheet" href="/css/leitura.css">
    <link rel="stylesheet" href="/css/categorias-realce.css">
