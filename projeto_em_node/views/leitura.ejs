<body class="tema-leitura">

<!-- TOPO + HEADER + MENU -->
<%- include("partials/topo") %>
<%- include("partials/header") %>
<%- include("partials/nav-categorias") %>

<!-- ================== HERO DA CATEGORIA (novo) ================== -->

<section class="hero-categoria">
    <span class="forma f1"></span><span class="forma f2"></span><span class="forma f3"></span><span class="forma f4"></span>
    <div class="hero-inner centralizado">
        <div class="hero-texto">
            <div class="hero-ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
            </div>
            <h1>Leituras</h1>
            <p>Trilhas de leitura por tema e gênero, para quem quer ir além dos livros da própria fase.</p>
            <div class="hero-chips">
                <a href="#aventura" class="hero-chip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.3"><path d="m12 2 3 6.5 7 .9-5.1 4.8 1.3 7L12 17.8 5.8 21.2l1.3-7L2 9.4l7-.9Z"/></svg>
                    Aventura
                </a>
                <a href="#ciencia" class="hero-chip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.3"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/></svg>
                    Ciência
                </a>
                <a href="#biografias" class="hero-chip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.3"><path d="M17 2H7a2 2 0 0 0-2 2v16l7-4 7 4V4a2 2 0 0 0-2-2Z"/></svg>
                    Biografias
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ================== FAIXA DECORATIVA (novo) ================== -->

<div class="faixa-decorativa">
    <a href="#aventura" class="item">
        <span class="bolha"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m12 2 3 6.5 7 .9-5.1 4.8 1.3 7L12 17.8 5.8 21.2l1.3-7L2 9.4l7-.9Z"/></svg></span>
        Aventura
    </a>
    <a href="#ciencia" class="item">
        <span class="bolha"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/></svg></span>
        Ciência
    </a>
    <a href="#biografias" class="item">
        <span class="bolha"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 2H7a2 2 0 0 0-2 2v16l7-4 7 4V4a2 2 0 0 0-2-2Z"/></svg></span>
        Biografias
    </a>
    <a href="#encontre-tambem" class="item">
        <span class="bolha"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M2 12h20"/></svg></span>
        Novas trilhas
    </a>
</div>

<!-- ================== AVENTURA ================== -->

<section class="categoria-livros" id="aventura">

